#define DEFAULT 0
#define NUM     1
#define NAV    2
#define SCROLL  3
#define SNIPE   4

#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include "behaviors.dtsi"
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "hold-preferred";
    quick-tap-ms = <0>;
};

&mt {
    tapping-term-ms = <100>;
    flavor = "tap-preferred";
    quick-tap-ms = <75>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWRT";
            bindings = <
                &lt 4 TAB       &kp Q        &kp W        &kp E        &kp R        &kp T
                &kp Y           &kp U        &kp I        &kp O        &kp P        &kp BACKSPACE

                &kp LEFT_SHIFT  &kp A        &kp S        &kp D        &kp F        &kp G
                &kp H           &kp J        &kp K        &kp L        &kp SEMI     &kp RIGHT_SHIFT

                &kp LCTRL       &kp Z        &kp X        &kp C        &kp V        &kp B
                &kp N           &kp M        &kp COMMA    &kp DOT      &kp SLASH    &kp RCTRL

                &mkp LCLK       &mo 3        &kp SPACE
                &kp ENTER       &td_num_nav
            >;
        };

        number_layer {
            display-name = "NUM";
            bindings = <
                &kp ESC              &kp GRAVE             &kp BACKSLASH    &kp APOSTROPHE      &kp LEFT_BRACKET    &kp RIGHT_BRACKET
                &none                &none                  &none            &none               &none                &trans

                &trans               &kp NUMBER_1          &kp NUMBER_2     &kp NUMBER_3        &kp NUMBER_4        &kp NUMBER_5
                &none                &kp LC(LS(LEFT))      &none            &kp LC(LS(RIGHT))   &none                &trans

                &trans               &kp NUMBER_6         &kp NUMBER_7      &kp NUMBER_8        &kp NUMBER_9        &kp NUMBER_0
                &kp EQUAL            &kp MINUS            &kp LC(S)             &none               &none                &trans

                &mkp RCLK            &trans                 &trans
                &trans               &trans
            >;
        };

        mouse_layer {
            display-name = "NAV";
            bindings = <
                &kp TAB         &trans          &trans       &trans       &trans       &trans
                &trans          &trans        &trans       &trans          &trans            &kp BACKSPACE

                &trans          &trans       &trans       &trans       &trans           &trans
                &trans          &kp LA(LG(LEFT))  &trans  &kp LA(LG(RIGHT))  &trans     &kp LG(LS(V))

                &trans          &trans       &trans       &trans       &trans           &trans
                &trans          &trans       &trans       &trans       &trans           &trans

                &mkp RCLK       &kp LC(UP)   &kp LC(LA(LG(SPACE)))
                &trans          &trans
            >;
        };

        scroll_layer {
            display-name = "SCROLL";
            bindings = <
                &kp TAB         &trans          &trans       &trans       &trans       &trans
                &trans          &trans        &kp UP       &trans          &trans            &kp BACKSPACE

                &trans          &trans       &trans       &trans       &trans           &trans
                &trans           &kp LEFT     &kp DOWN     &kp RIGHT    &trans            &kp LG(LS(V))

                &trans          &trans       &trans       &trans       &trans           &trans
                &trans          &trans       &trans       &trans       &trans           &trans

                &trans       &trans       &trans
                &kp LALT   &kp LGUI
            >;
        };

        snipe_layer {
            display-name = "SNIPE";
            bindings = <
                &kp F1      &kp F2       &kp F3           &kp F4           &kp F5         &kp F6
                &kp F7      &kp F8       &kp F9           &kp F10          &kp F11        &kp F12

                &trans      &bt BT_CLR   &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2   &none
                &none       &kp LA(LG(LEFT))  &none          &kp LA(LG(RIGHT))    &kp LG(SPACE)  &studio_unlock

                &trans      &trans       &trans           &trans           &trans         &trans
                &kp C_MUTE  &kp C_VOL_DN &kp C_VOL_UP     &kp C_BRI_DN     &kp C_BRI_UP   &trans

                &trans              &trans              &trans
                &kp LC(UP)   &kp LC(LA(LG(SPACE)))
            >;
        };
    };
};